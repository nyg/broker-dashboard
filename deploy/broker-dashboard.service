[Unit]
Description=Broker dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/broker-dashboard
EnvironmentFile=%h/.config/broker-dashboard/env
ExecStart=%h/.local/opt/broker-dashboard/deploy/start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.broker-dashboard
PrivateTmp=true

[Install]
WantedBy=default.target
