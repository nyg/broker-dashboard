{
  "name": "saxo-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Saxo Bank portfolio and margin dashboard that keeps its OpenAPI login alive.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node src/server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "big.js": "7.0.1",
    "hono": "4.13.21"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@nyg/eslint-config": "github:nyg/eslint-config#v1.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/big.js": "7.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.15.0"
}
